# Delta Exchange India testnet by default. Global URLs are also supported.
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=
DELTA_API_SECRET=

# Safe defaults: monitor signals, but do not place orders.
ENABLE_TRADING=false
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=

# Delta India ETCUSD is USD-quoted; the confirmed cap is 1 USD notional.
MAX_NOTIONAL_USD=1
STOP_LOSS_PCT=0.01
TAKE_PROFIT_PCT=0.02
POLL_SECONDS=5
LOG_LEVEL=INFO
